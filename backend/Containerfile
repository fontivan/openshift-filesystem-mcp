# Node.js backend: mcp-proxy + server-filesystem (stdio-to-HTTP, no transforms).
# Host paths mounted at /host/* at runtime. Listens on port 8081 for proxy.

FROM registry.access.redhat.com/ubi9/nodejs-22:latest@sha256:6411ae77358bab07718f2c3dfdd44bf0d2c32f1ee5938d4471c3df693f4b3492

ENV SUMMARY="MCP server-filesystem backend (mcp-proxy + stdio)" \
    DESCRIPTION="Model Context Protocol filesystem server via mcp-proxy. Exposes HTTP for upstream proxy."

LABEL name="openshift-filesystem-mcp-backend" \
      summary="${SUMMARY}" \
      description="${DESCRIPTION}" \
      io.k8s.display-name="openshift-filesystem-mcp-backend" \
      io.k8s.description="${DESCRIPTION}" \
      io.openshift.tags="mcp,filesystem,nodejs"

# Install dependencies from locked package-lock.json for reproducible builds
WORKDIR /opt/app-root/src
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

ENV NPM_CONFIG_CACHE=/tmp/.npm
ENV PORT=8081
EXPOSE 8081

# Entrypoint: mcp-proxy wraps server-filesystem; paths from MCP_HOST_ROOT
WORKDIR /opt/app-root/src
ENTRYPOINT ["sh", "-c", "exec npx mcp-proxy --port ${PORT:-8081} -- npx @modelcontextprotocol/server-filesystem ${MCP_HOST_ROOT:-/host}/etc ${MCP_HOST_ROOT:-/host}/sys ${MCP_HOST_ROOT:-/host}/proc ${MCP_HOST_ROOT:-/host}/usr"]
